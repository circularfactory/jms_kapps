# pytest-playwright's traces, screenshots and videos, with its --tracing, --screenshot, --video
test-results/

# Local agent output: the orchestrator's run logs per task, and scratch notes. A build's
# handoff and briefs under .claude/log/<ticket>/ stay trackable; only runs/ is machine output.
.claude/log/*/runs/
.scratch/

# The §7 experiment's results and prefills: a run on the shared store names its host, which a
# shipped file may not; the final run is archived through the reproduction archive.
evaluation/section_7/results/
evaluation/section_7/prefills/

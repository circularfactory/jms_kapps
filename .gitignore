.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/
.env
# pytest-playwright's traces, screenshots and videos, with its --tracing, --screenshot, --video
test-results/

# Local agent output: the orchestrator's run logs per task, and scratch notes. A build's
# handoff and briefs under .claude/log/<ticket>/ stay trackable; only runs/ is machine output.
.claude/log/*/runs/
.scratch/

# The commit time experiment's results and prefills: a run on the shared store names its host,
# which a shipped file may not. The paper's run is tracked packed, in raw_data/ and reports/,
# with the banned strings replaced; the store folders unpacked from its archives are not.
commit_time/results/*
!commit_time/results/raw_data/
!commit_time/results/reports/
commit_time/results/raw_data/*/
commit_time/prefills/

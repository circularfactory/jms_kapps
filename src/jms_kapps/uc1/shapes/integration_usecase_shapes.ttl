@prefix : <https://sfb1574.kit.edu/ontologies/JMS_Usecase_Demo#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

#################################################################
# SHACL shapes of use case 1
#
# Added on 2026-10-16 (jms_kapps 59). One shape: the PROV witness on the decision. A decision
# snapshot must name the classification that generated it, so the store refuses a snapshot
# without its provenance. OWL cannot require this, because it says what can be, not what must be;
# the closed-world rule is SHACL's, at the store.
#
# The property shape has an IRI, so that the validation report names it.
#################################################################

:DecisionSnapshotShape a sh:NodeShape ;
    rdfs:label "Decision snapshot shape"@en ;
    sh:targetClass :DecisionSnapshot ;
    sh:property :DecisionSnapshotGeneratedByShape .

:DecisionSnapshotGeneratedByShape a sh:PropertyShape ;
    rdfs:label "Decision snapshot generated by shape"@en ;
    sh:path prov:wasGeneratedBy ;
    sh:minCount 1 ;
    sh:class prov:Activity ;
    sh:message "A decision snapshot must name the classification that generated it (prov:wasGeneratedBy)."@en .

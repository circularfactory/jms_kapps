@prefix : <http://w3id.org/circularfactory/Unscrewing#> .
@prefix cfc: <http://w3id.org/circularfactory/Core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# SHACL shapes of use case 1
#
# Three shapes. The first is the PROV witness on the decision. A parameter
# copy must name the classification that generated it, so the store refuses a parameter copy
# without its provenance. OWL cannot require this, because it says what can be, not what must be;
# the closed-world rule is SHACL's, at the store.
#
# The second: every capability belongs to exactly one resource. A capability cannot exist without
# a resource, and a resource can have several, so exactly one resource links to each capability
# (`cfc:hasCapability`), and an operation that implements a capability runs on that capability's
# resource. The store's SHACL may not follow rdfs:subClassOf, and the middleware types a capability
# by its use case's class only, so the shape targets cfc:Capability and each of use case 1's
# capability classes.
#
# The third: an unscrewing operation is planned only for a Screw whose Screw type holds each of
# the seven values the attempt needs, the six detection thresholds and the preparation turning
# angle. The planner's commit of the operation is the write the store checks, so the store refuses
# an operation that the factory information state cannot carry out before any resource is
# notified. The rule is written in nested single steps, operation to Screw to Screw type, each
# property shape with a path of one property, because the store's SHACL engine fails with an
# internal error on writes that meet a sequence path inside `sh:node`, or a minimum count on a
# sequence path.
#
# Each property shape that a report names has an IRI. The inner property shapes of the third rule
# are blank nodes: the store reports their violation at the outer one,
# `:UnscrewingOperationScrewShape`, with its message.
#################################################################

:ParameterCopyShape a sh:NodeShape ;
    rdfs:label "Parameter copy shape"@en ;
    sh:targetClass :ParameterCopy ;
    sh:property :ParameterCopyGeneratedByShape .

:ParameterCopyGeneratedByShape a sh:PropertyShape ;
    rdfs:label "Parameter copy generated by shape"@en ;
    sh:path prov:wasGeneratedBy ;
    sh:minCount 1 ;
    sh:class prov:Activity ;
    sh:message "A parameter copy must name the classification that generated it (prov:wasGeneratedBy)."@en .

:CapabilityShape a sh:NodeShape ;
    rdfs:label "Capability shape"@en ;
    sh:targetClass cfc:Capability ,
        :ClassifyCapability ,
        :StartUnscrewingCapability ,
        :UnscrewingCapability ;
    sh:property :CapabilityResourceShape .

:CapabilityResourceShape a sh:PropertyShape ;
    rdfs:label "Capability resource shape"@en ;
    sh:path [ sh:inversePath cfc:hasCapability ] ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "A Capability must belong to exactly one resource: exactly one resource links to it with cfc:hasCapability."@en .

:UnscrewingOperationShape a sh:NodeShape ;
    rdfs:label "Unscrewing operation shape"@en ;
    sh:targetClass :UnscrewingOperation ;
    sh:property :UnscrewingOperationScrewShape .

:UnscrewingOperationScrewShape a sh:PropertyShape ;
    rdfs:label "Unscrewing operation screw shape"@en ;
    sh:path :concernsScrew ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node :ScrewOfMeasuredTypeShape ;
    sh:message "An unscrewing operation concerns exactly one Screw, whose Screw type holds each of the seven values the attempt needs (the six detection thresholds and the preparation turning angle), once each."@en .

:ScrewOfMeasuredTypeShape a sh:NodeShape ;
    rdfs:label "Screw of measured type shape"@en ;
    sh:property [ sh:path :hasScrewType ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:node :MeasuredScrewTypeShape ] .

:MeasuredScrewTypeShape a sh:NodeShape ;
    rdfs:label "Measured screw type shape"@en ;
    sh:property [ sh:path :hasMinApproachAxialForce ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ] ;
    sh:property [ sh:path :hasMinCounterTorque ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ] ;
    sh:property [ sh:path :hasMinPreloadAxialForce ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ] ;
    sh:property [ sh:path :hasPreparationTurningAngle ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ] ;
    sh:property [ sh:path :hasMaxLooseTorque ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ] ;
    sh:property [ sh:path :hasMinLooseningAxialForce ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ] ;
    sh:property [ sh:path :hasMaxDynamicTorque ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ] .

@prefix : <http://w3id.org/circularfactory/FlexConveyor#> .
@prefix cfc: <http://w3id.org/circularfactory/Core#> .
@prefix svc: <http://w3id.org/circularfactory/Service#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# SHACL-SPARQL shapes for the FlexConveyor System
#
# One rule that SHACL Core cannot express: a transport may only be opened toward a destination
# that the station's connections reach from its origin. It is kept apart from
# `flexconveyor_usecase_shapes.ttl`, the Core shapes that every launch of use case 2 seeds, and
# loaded only on request (`seed.reset_uc2(..., sparql_shapes=True)`): by the live shape tests, which
# prove it, by `jms-uc2 reachable-destination`, which shows it, and by `jms-uc2 audit`, which validates a
# dataset against both files. The store
# receives both files as one shapes document, so the rule is enforced at commit like a Core rule
# wherever it is loaded.
#
# Why apart. The rule's target is a SPARQL query over every transport. The store evaluates such
# a target over the whole dataset at every commit, not only for the nodes a write touches
# (measured: a removed connection is refused on a commit that never touches the transport), so
# every commit pays for a property path over every transport in the dataset, and the price
# grows with the dataset. The paper's evaluation runs on datasets of up to millions of
# statements and reports commit latency; with the rule in the seeded shapes, its figures would
# measure this one rule rather than the use case's validation. The seeded shapes therefore stay
# SHACL Core, which the store validates incrementally, and this file is the demonstration that
# SHACL-SPARQL is supported where a rule needs it.
# vendor-check: off -- the backend the shapes were measured on
# Measured on GraphDB 10.8.5 (RDF4J 4.3.15): the store refuses at commit a
# transport created toward an unreachable destination, a destination changed to an unreachable
# module, and a connection removed so that a transport's destination is no longer reached. The
# head of `flexconveyor_usecase_shapes.ttl` records what the same store does with a SHACL-SPARQL
# constraint on a class target.
# vendor-check: on
#################################################################

#################################################################
# 3. THE TRANSPORT'S DESTINATION, IN SHACL-SPARQL
#
# A transport may only be opened toward a destination that the station's connections reach from
# its origin, one way, over any number of hops: the rule the WarehouseManagementSystem applies
# when it picks a destination. SHACL Core cannot say it: a property path can follow the
# connections from the origin, but no Core constraint compares the modules it reaches with
# another value of the same focus node, the destination. So the rule is a SPARQL target that
# finds each transport whose destination is not reached, and a SPARQL constraint that names that
# destination as the result's value. The result has no path.
#################################################################

: sh:declare [ sh:prefix "fc" ; sh:namespace "http://w3id.org/circularfactory/FlexConveyor#"^^xsd:anyURI ] .

:ReachableDestinationShape a sh:NodeShape ;
    sh:target [ a sh:SPARQLTarget ; sh:prefixes : ;
        sh:select """SELECT ?this WHERE {
            ?this a fc:BoxTransportOperation ; fc:hasOrigin ?origin ; fc:hasDestination ?destination .
            FILTER NOT EXISTS { ?origin (fc:hasConnection/fc:connectsTo)+ ?destination }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes : ;
        sh:message "A BoxTransportOperation's destination must be reachable from its origin over the station's connections." ;
        sh:select """SELECT $this ?value WHERE { $this fc:hasDestination ?value }""" ] .
